rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidXpUpdate() {
      // Anti-cheat: prevent more than 500 XP in a single write
      return !('xp' in request.resource.data) ||
             (request.resource.data.xp - resource.data.xp) <= 500;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && isValidXpUpdate();
      allow delete: if false;
    }

    // User progress
    match /userProgress/{progressId} {
      allow read, write: if isAuthenticated() &&
        progressId.matches(request.auth.uid + '_.*');
    }

    // Subjects (public read, admin write only)
    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if false;

      match /chapters/{chapterId} {
        allow read: if true;
        allow write: if false;

        match /lessons/{lessonId} {
          allow read: if true;
          allow write: if false;
        }
      }
    }

    // Quiz attempts (user can write their own)
    match /quizAttempts/{attemptId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Leaderboard (public read, system write)
    match /leaderboard/{entryId} {
      allow read: if true;
      allow write: if false;
    }

    // AI Chat history (private)
    match /aiHistory/{userId}/{messageId} {
      allow read, write: if isOwner(userId);
    }

    // Missions
    match /missions/{missionId} {
      allow read: if true;
      allow write: if false;
    }

    // User missions progress
    match /userMissions/{userId}/{missionId} {
      allow read, write: if isOwner(userId);
    }

    // Notifications
    match /notifications/{userId}/{notifId} {
      allow read, delete: if isOwner(userId);
      allow create: if false;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
